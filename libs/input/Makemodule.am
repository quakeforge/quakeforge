libs_input_libs=libs/input/libQFinput.la
lib_LTLIBRARIES += @libs_input_libs@
EXTRA_LTLIBRARIES += $(libs_input_libs)

input_evdev=libs/input/libinput_evdev.la
input_xinput=libs/input/libinput_xinput.la

noinst_LTLIBRARIES += @input_libs@
EXTRA_LTLIBRARIES += $(input_evdev) $(input_xinput)

input_deps = @input_libs@ libs/util/libQFutil.la

in_evdev_src=	\
	libs/input/evdev/hotplug.c \
	libs/input/evdev/inputlib.c \
	libs/input/in_evdev.c

in_xinput_src=	\
	libs/input/xinput/xi.c \
	libs/input/in_xinput.c

libs_input_libinput_evdev_la_LIBADD=
libs_input_libinput_evdev_la_DEPENDENCIES=
libs_input_libinput_evdev_la_CFLAGS=
libs_input_libinput_evdev_la_SOURCES=      $(in_evdev_src)

libs_input_libinput_xinput_la_LIBADD=
libs_input_libinput_xinput_la_DEPENDENCIES=
libs_input_libinput_xinput_la_CFLAGS=
libs_input_libinput_xinput_la_SOURCES=      $(in_xinput_src)

libs_input_libQFinput_la_LDFLAGS=		$(lib_ldflags)
libs_input_libQFinput_la_LIBADD=		$(input_deps)
libs_input_libQFinput_la_DEPENDENCIES=	$(input_deps)
libs_input_libQFinput_la_SOURCES= \
	libs/input/in_axis.c \
	libs/input/in_axis_button.c \
	libs/input/in_binding.c \
	libs/input/in_button.c \
	libs/input/in_common.c \
	libs/input/in_event.c \
	libs/input/in_gamepad.c \
	libs/input/in_imt.c \
	libs/input/keys.c

EXTRA_DIST += \
	libs/input/gamecontrollerdb.txt \
	libs/input/gamecontrollerdb_qf.txt
